#!/usr/bin/env bash
# pre-push: regenerate the profile cards so pushed data is always current.
# Install with: scripts/install-hooks.sh
#
# If regeneration produces a visual change, this creates a commit and aborts
# the push so you re-run `git push` with the fresh cards included.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Skip if gh isn't authenticated — don't block a push on a missing credential.
if ! gh auth status >/dev/null 2>&1; then
  echo "pre-push: gh not authenticated, skipping card refresh" >&2
  exit 0
fi

python scripts/gen_header.py
python scripts/gen_langs.py
python scripts/gen_stats.py

git add -- assets/header-dark.svg assets/header-light.svg \
           assets/lang-dark.svg assets/lang-light.svg \
           assets/stats-dark.svg assets/stats-light.svg

if git diff --cached --quiet; then
  exit 0   # no change, let the push proceed
fi

git commit -m 'chore(assets): refresh generated cards'
echo "pre-push: cards changed and were committed. Re-run 'git push' to include them." >&2
exit 1     # abort so the new commit is actually pushed
